# --- Build Directories ---
# Ignore the entire build folder (common names: build, bin, out)
build/
bin/
out/
/cmake-build-*/

# --- CMake Artifacts ---
# Exclude files generated by CMake that should not be version controlled
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# --- C++ Objects and Binaries ---
# Compiled object files, libraries, and executables
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.exe
*.out
*.app

# --- IDE & Editor Specific ---
# Visual Studio
.vs/
*.sln
*.vcxproj
*.user
# VS Code
.vscode/
# CLion / JetBrains
.idea/
*.iws
example/


# --- OS Specific ---
.DS_Store
Thumbs.db
